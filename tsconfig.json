{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": [
            "node",
            "obsidian"
        ],
        "lib": [
            "DOM",
            "ES2020"
        ],
        "baseUrl": "."
    },
    "include": [
        "src/**/*.ts"
    ]
}